# Porta do servidor Express (padrão: 3000)
PORT=3000

# Credenciais da Meteomatics Weather API (recebidas por e-mail ao criar a conta em meteomatics.com)
# Sem elas o servidor responde /api/weather com dados simulados
METEOMATICS_USER=seu_usuario
METEOMATICS_PASSWORD=sua_senha

# Banco de dados PostgreSQL (referência histórica — o projeto usa db.json local)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missao_taquari
